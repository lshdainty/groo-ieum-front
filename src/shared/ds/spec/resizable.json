{
  "name": "Resizable",
  "source": "specs/components/resizable.yaml",
  "design": {
    "file": "DESIGN.hr.md",
    "sha256": "3cc8ca281786"
  },
  "slots": {
    "group": "나눈 자리 — 목록 | 상세 두 패널",
    "panel": "목록 패널(왼쪽) — 폭이 바뀐다. 상세 패널은 남는 폭",
    "handle": "손잡이 — 두 패널 사이. role=\"separator\", 누르는 폭 16",
    "line": "보이는 선 — 1px",
    "grip": "가운데 손잡이 표시 — 4 × 24",
    "focusRing": "키보드 포커스 링(웹) — 손잡이 둘레"
  },
  "axes": {
    "kind": [
      "split"
    ]
  },
  "defaults": {
    "kind": "split"
  },
  "states": [
    "enabled",
    "hovered",
    "focused",
    "pressed"
  ],
  "rules": [
    {
      "when": {
        "kind": "split"
      },
      "enabled": {
        "group": {
          "direction": "가로",
          "breakpoint": "768px 이상"
        },
        "panel": {
          "width": "25%",
          "minWidth": "20%",
          "maxWidth": "40%",
          "toggleWidth": "40%",
          "persist": "화면마다 기억"
        },
        "handle": {
          "width": 16,
          "cursor": "col-resize",
          "touchAction": "none",
          "touchTarget": "16 × 패널 높이",
          "name": "목록 너비",
          "keyboard": "← → 5% · Home 20% · End 40% · Enter 25 ↔ 40",
          "step": "5%",
          "press": "누르면 25 ↔ 40",
          "dragStart": 3
        },
        "line": {
          "width": 1,
          "background": {
            "light": "#E5E8EF",
            "dark": "#404757"
          },
          "transitionProperty": "background-color",
          "transitionDuration": "150ms",
          "transitionEasing": "cubic-bezier(0.35, 0, 0.35, 1)"
        },
        "grip": {
          "width": 4,
          "height": 24,
          "radius": 2,
          "background": {
            "light": "#767C8B",
            "dark": "#838997"
          },
          "position": "선 가운데"
        }
      },
      "hovered": {
        "line": {
          "background": {
            "light": "#767C8B",
            "dark": "#838997"
          }
        }
      },
      "focused": {
        "line": {
          "background": {
            "light": "#767C8B",
            "dark": "#838997"
          }
        },
        "focusRing": {
          "width": 2,
          "offset": 0,
          "radius": 4,
          "color": {
            "light": "#075B3C",
            "dark": "#2ABE84"
          }
        }
      },
      "pressed": {
        "line": {
          "background": {
            "light": "#767C8B",
            "dark": "#838997"
          }
        },
        "group": {
          "cursor": "col-resize"
        }
      }
    }
  ],
  "motion": {
    "선 — 색": {
      "duration": "150ms",
      "easing": "cubic-bezier(0.35, 0, 0.35, 1)",
      "properties": [
        "background-color"
      ],
      "note": "올리거나 초점 · 끄는 동안 선이 짙어진다"
    },
    "목록 폭": {
      "properties": [
        "width"
      ],
      "note": "끄는 동안 포인터를 1:1 로 따라가고, 키보드 · 누르기는 바로 바뀐다 — 모션이 없다"
    }
  },
  "notes": [
    {
      "rule": 0,
      "state": "enabled",
      "slot": "group",
      "prop": "direction",
      "note": "목록 | 상세 — 세로 나누기 · 셋 이상 나누기는 쓰는 곳이 없어 두지 않는다"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "group",
      "prop": "breakpoint",
      "note": "768 미만은 나누지 않는다 — 역할 · 사용자는 목록 → 상세, 회사는 탭(지금과 같다)"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "panel",
      "prop": "width",
      "note": "목록 패널의 기본 폭 — 1280 에서 본문 992 의 248(사이드바 240 · 여백 24 × 2)"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "panel",
      "prop": "minWidth",
      "note": "목록이 이보다 좁아지지 않는다"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "panel",
      "prop": "maxWidth",
      "note": "오른쪽 상세가 60% 아래로 줄지 않는다 — 지금 회사 · 부서 사용자는 0폭까지 민다"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "panel",
      "prop": "toggleWidth",
      "note": "손잡이를 한 번 누르면(Enter) 기본 25 ↔ 넓게 40"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "panel",
      "prop": "persist",
      "note": "끌거나 누른 폭을 브라우저에 저장한다(localStorage — 키는 화면: 역할 · 사용자 · 회사 · 부서 사용자). 사이드바 접힘처럼 다시 열면 그 폭"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "handle",
      "prop": "width",
      "note": "누르는 폭 — 선 가운데로 양쪽 8. 768 이상 데스크톱의 마우스 경계라 44 가 아니다(사용자 결정 12B)"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "handle",
      "prop": "touchAction",
      "note": "끄는 동안 화면이 스크롤되지 않게"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "handle",
      "prop": "touchTarget",
      "note": "AA ⚠(폭 16) · AAA ✗ — 같은 일을 누르기(25 ↔ 40) · 키보드로도 한다"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "handle",
      "prop": "name",
      "note": "role=separator · aria-orientation=vertical · aria-valuenow(목록 %) · aria-valuemin 20 · aria-valuemax 40 · aria-controls(목록 패널)"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "handle",
      "prop": "keyboard",
      "note": "APG Window Splitter — Shift + 화살표는 두지 않는다"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "handle",
      "prop": "step",
      "note": "← → 한 번에 — 지금 HR 은 10%"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "handle",
      "prop": "press",
      "note": "끌지 않고 한 번 눌렀다 떼면(3px 안) 기본 25 ↔ 넓게 40 — WCAG 2.5.7 Dragging Movements 의 대안"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "handle",
      "prop": "dragStart",
      "note": "누른 채 3px 넘게 움직이면 끌기 — 그 안에서 놓으면 누르기"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "line",
      "prop": "background",
      "note": "흰 면 위 1.23 · 다크 1.56 — 경계일 뿐이고 손잡이는 가운데 표시가 알린다"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "grip",
      "prop": "background",
      "note": "흰 면 위 4.18 · 다크 4.13(WCAG 1.4.11 ≥ 3) — 지금 HR 은 선 · 손잡이가 모두 #EEEEEE 1.11"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "grip",
      "prop": "position",
      "note": "패널 높이의 가운데"
    },
    {
      "rule": 0,
      "state": "hovered",
      "slot": "line",
      "prop": "background",
      "note": "선 전체가 손잡이 표시와 같은 색 — 끌 수 있는 자리가 보인다"
    },
    {
      "rule": 0,
      "state": "focused",
      "slot": "focusRing",
      "prop": "offset",
      "note": "누르는 폭 16 둘레 — 패널 높이 전체"
    },
    {
      "rule": 0,
      "state": "pressed",
      "slot": "group",
      "prop": "cursor",
      "note": "끄는 동안 화면 전체 — 글을 고르지 않는다(user-select none)"
    }
  ]
}
